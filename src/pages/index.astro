---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, interests, albums, reading, projects, bookmarks } from '../data/site';
import { getPosts, postUrl, formatDate } from '../lib/posts';
const posts = await getPosts();
const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: site.timezone, hour: '2-digit', hour12: false }).format(new Date()));
---
<BaseLayout active="home" wide immersive>
  <section class="home-intro" aria-labelledby="home-title">
    <div><p class="eyebrow"><span class="eyebrow-line"></span>A LITTLE CORNER OF THE INTERNET</p><h1 id="home-title" class="home-motto">{site.motto}</h1><a class="home-signature" href="/about/"><img src={site.avatar} width="29" height="29" alt="" /><span><strong>{site.name}</strong><small>{site.tagline}</small></span></a></div>
    <div class="intro-aside"><span class="intro-sticker"><Icon name="leaf" size={21} /></span><p>一些想法，一些收藏，<br />还有一点认真生活的痕迹。</p><span class="intro-tiny">MAKE ROOM FOR WHAT MATTERS.</span></div>
  </section>

  <section class="bento-grid" aria-label="我的数字花园">
    <article class="garden-card profile-card">
      <div class="card-topline"><span class="card-eyebrow">ABOUT ME</span><span class="status-pill"><span class="live-dot"></span>保持好奇</span></div>
      <div class="profile-avatar"><img src={site.avatar} width="88" height="88" alt={`${site.name} 的头像`} /><span class="avatar-badge" aria-label="小小的问候">✳</span></div>
      <h2>{site.name}<span class="profile-name-dot">.</span></h2>
      <p class="profile-tagline">{site.tagline}</p>
      <p class="profile-bio">{site.bio}</p>
      <div class="profile-interests">{interests.map(item => <span><Icon name={item.icon} size={13} />{item.label}</span>)}</div>
      <div class="profile-bottom"><div class="profile-socials"><a href={site.github} target="_blank" rel="noopener noreferrer" aria-label="访问 GitHub"><Icon name="github" size={19} /></a><a href="/rss.xml" aria-label="订阅 RSS"><Icon name="rss" size={18} /></a><a href="/about/#contact" aria-label="联系我"><Icon name="mail" size={19} /></a></div><a class="text-link" href="/about/">认识一下<Icon name="arrow" size={15} /></a></div>
    </article>

    <article class="garden-card clock-card">
      <div class="card-topline"><span class="card-eyebrow"><Icon name="clock" size={13} />此时此刻</span><span class="small-muted">UTC +8</span></div>
      <div class="clock-face"><span data-clock>{new Intl.DateTimeFormat('en-GB', { timeZone: site.timezone, hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date())}</span><span class="clock-sun" aria-hidden="true"><Icon name="sun" size={43} /></span></div>
      <div class="clock-bottom"><span data-clock-date>{new Intl.DateTimeFormat('zh-CN', { timeZone: site.timezone, month: 'long', day: 'numeric', weekday: 'long' }).format(new Date())}</span><span class="clock-message" data-greeting>{hour >= 5 && hour < 12 ? '新的一天，慢慢来。' : hour >= 12 && hour < 18 ? '给自己留一点空闲。' : '今晚，也给自己一点时间。'}</span></div>
    </article>

    <article class="garden-card notes-card">
      <div class="card-topline"><span class="card-eyebrow"><Icon name="pen" size={13} />最近写下</span><a href="/blog/" class="icon-button" aria-label="查看所有文章"><Icon name="arrow" size={17} /></a></div>
      <div class="home-posts">{posts.slice(0, 3).map(post => <a href={postUrl(post.id)}><span class:list={['mini-post-icon', post.data.color]}><Icon name={post.data.icon} size={17} /></span><span class="mini-post-text"><strong>{post.data.title}</strong><small>{post.data.category} · {formatDate(post.data.date, true)}</small></span><Icon name="chevron" size={14} /></a>)}</div>
    </article>

    <article class="garden-card music-card">
      <div class="card-topline"><span class="card-eyebrow"><Icon name="headphones" size={13} />音乐灵感</span><span class="music-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span></div>
      <div class="music-main"><div class="album-sleeve"><span class="vinyl" aria-hidden="true"></span><img data-album-cover src={albums[0].cover} width="100" height="100" alt={albums[0].title} /></div><div class="music-copy"><span class="music-kicker" data-album-tag>{albums[0].tag}</span><h2 data-album-title>{albums[0].title}</h2><p data-album-subtitle>{albums[0].subtitle}</p></div></div>
      <div class="music-bottom"><a class="text-link" href="/library/?category=music">收藏的声音<Icon name="arrow" size={14} /></a><div class="album-controls"><span data-album-number>01 / 03</span><button class="round-button" type="button" data-album-next aria-label="切换下一张音乐封面"><Icon name="right" size={17} /></button></div></div>
    </article>

    <article class="garden-card book-card">
      <div class="card-topline"><span class="card-eyebrow"><Icon name="book" size={13} />书架一角</span><a href="/library/?category=books" class="icon-button" aria-label="浏览书架"><Icon name="arrow" size={17} /></a></div>
      <div class="book-main"><a href={reading.url} target="_blank" rel="noopener noreferrer" class="book-cover-link" aria-label={`了解《${reading.title}》`}><img src={reading.cover} width="79" height="110" alt={`《${reading.title}》概念封面`} loading="lazy" /></a><div><span class="book-status">下一本想读</span><h2>{reading.title}</h2><p>{reading.author}</p><span class="book-quote">{reading.note}</span></div></div>
    </article>

    <article class="garden-card projects-card">
      <div class="card-topline"><span class="card-eyebrow"><Icon name="layers" size={13} />正在折腾</span><a class="small-link" href="/library/?category=projects">全部<Icon name="arrow" size={13} /></a></div>
      <div class="home-projects">{projects.map(project => <a href={project.href}><span class:list={['project-symbol', project.color]}><Icon name={project.icon} size={23} /></span><span class="project-copy"><strong>{project.title}</strong><small>{project.subtitle}</small><span class="project-tags">{project.tags.slice(0, 2).map(tag => <i>{tag}</i>)}</span></span><Icon name="arrow" size={16} /></a>)}</div>
      <div class="project-note"><span class="live-dot"></span>小步向前，持续更新</div>
    </article>

    <a class="garden-card landscape-card" href="/blog/a-place-for-thoughts/" aria-label="阅读文章：给想法一个安静的住处">
      <img src="/images/landscape.svg" width="800" height="450" alt="柔和的山丘、小路与日落插画" loading="lazy" />
      <div class="landscape-text"><span class="card-eyebrow">A NOTE TO SELF</span><h2>慢一点，<br />也没有关系。</h2><p>让生活留一点空白。</p></div><span class="landscape-arrow"><Icon name="arrow" size={19} /></span>
    </a>

    <article class="garden-card bookmarks-card">
      <div class="card-topline"><span class="card-eyebrow"><Icon name="bookmark" size={13} />常逛的小站</span><a href="/library/?category=bookmarks" class="icon-button" aria-label="查看收藏链接"><Icon name="arrow" size={17} /></a></div>
      <div class="bookmark-links">{bookmarks.slice(0, 3).map(item => <a href={item.href} target="_blank" rel="noopener noreferrer"><span class:list={['bookmark-symbol', item.color]}><Icon name={item.icon} size={19} /></span><span><strong>{item.name}</strong><small>{item.description}</small></span><Icon name="arrow" size={14} /></a>)}</div>
    </article>

    <article class="garden-card garden-note-card">
      <span class="note-flower" aria-hidden="true"><Icon name="flower" size={46} /></span><div><span class="card-eyebrow">THIS GARDEN IS GROWING</span><h2>留下一点，<br />属于自己的东西。</h2><p>现在有 <strong>{posts.length}</strong> 篇笔记，<br />还有很多故事，等着慢慢写。</p></div><a class="text-link" href="/blog/">去读一读<Icon name="right" size={15} /></a>
    </article>
  </section>
  <div class="home-endnote"><span></span><Icon name="flower" size={17} /><p>谢谢你路过这里。</p><span></span></div>

  <script define:vars={{ albumData: albums }}>
    (() => {
      let current = 0;
      document.querySelector('[data-album-next]')?.addEventListener('click', () => {
        current = (current + 1) % albumData.length;
        const album = albumData[current];
        const cover = document.querySelector('[data-album-cover]');
        if (cover) { cover.setAttribute('src', album.cover); cover.setAttribute('alt', album.title); }
        const fields = { '[data-album-title]': album.title, '[data-album-subtitle]': album.subtitle, '[data-album-tag]': album.tag, '[data-album-number]': `${String(current + 1).padStart(2, '0')} / ${String(albumData.length).padStart(2, '0')}` };
        Object.entries(fields).forEach(([selector, text]) => { const element = document.querySelector(selector); if (element) element.textContent = text; });
      });
    })();
  </script>
</BaseLayout>
