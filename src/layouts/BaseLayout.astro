---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; active?: string; wide?: boolean; article?: boolean; immersive?: boolean }
const { title, description = site.description, active = 'home', wide = false, article = false, immersive = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = Astro.site && Astro.site.hostname !== 'example.com' ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let theme = 'light';
        try { theme = localStorage.getItem('garden-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch {}
        document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class:list={{ 'immersive-home': immersive }}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    {immersive && <><div class="home-wallpaper" style={`background-image: url('${site.wallpaper}')`} aria-hidden="true"></div><div class="wallpaper-wash" aria-hidden="true"></div></>}
    <Nav active={active} />
    <div class:list={['page-shell', { 'page-shell-wide': wide }]}>
      <header class="topbar">
        <a class="wordmark" href="/"><Icon name="flower" size={19} /><span>{site.name}<span class="wordmark-dot">.</span></span></a>
        <div class="topbar-right"><span class="live-dot"></span><span class="topbar-note">保持好奇，慢慢生长</span>{immersive && <button class="layout-switch" type="button" data-layout-toggle aria-label="切换为完整卡片视图"><Icon name="grid" size={15} /><span>卡片视图</span></button>}<button class="topbar-search" type="button" data-search-open aria-label="搜索文章"><Icon name="search" size={17} /><kbd>⌘ K</kbd></button></div>
      </header>
      <main id="main-content"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {site.name}<span class="footer-dot">·</span>一个慢慢生长的数字花园</span>
        <div><a href="/rss.xml" aria-label="订阅 RSS"><Icon name="rss" size={15} /><span>RSS</span></a><span class="footer-made">Made with care <Icon name="heart" size={13} /></span><button type="button" data-scroll-top aria-label="回到顶部"><Icon name="arrow" size={17} /></button></div>
      </footer>
    </div>
    <Search />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
